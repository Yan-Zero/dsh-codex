{
  "name": "dsh-codex",
  "description": "Portable OpenAI Codex model provider for DSH standard runtimes",
  "version": "0.2.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yan-Zero/dsh-codex.git"
  },
  "homepage": "https://github.com/Yan-Zero/dsh-codex#readme",
  "bugs": {
    "url": "https://github.com/Yan-Zero/dsh-codex/issues"
  },
  "type": "module",
  "main": "lib/standard.js",
  "types": "lib/standard.d.ts",
  "bin": {
    "dsh-openai-codex": "lib/bin.js"
  },
  "scripts": {
    "build": "pnpm run typecheck && tsdown",
    "test": "vitest run tests/standard-component.spec.ts tests/store.spec.ts tests/response-runtime.spec.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm --config.minimum-release-age=0 run check"
  },
  "exports": {
    ".": {
      "types": "./lib/standard.d.ts",
      "default": "./lib/standard.js"
    },
    "./standard": {
      "types": "./lib/standard.d.ts",
      "default": "./lib/standard.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "INSTALL.md"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@dsh-std/command": "^0.1.0",
    "@dsh-std/model": "^0.1.0",
    "@dsh-std/presentation": "^0.1.0",
    "@dsh-std/sdk": "^0.1.0",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
