{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "manifestVersion": "0.15",
  "id": "ai.openai.codex",
  "name": "OpenAI Codex",
  "version": "0.2.4",
  "facets": {
    "host": {
      "entry": "lib/standard.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      },
      {
        "apiVersion": "presentation.dsh/v1alpha1",
        "kind": "OpenExternal",
        "optional": true,
        "fallback": "use device-code authentication"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "ai.openai.codex.command.codex",
      "reason": "Expose the account and provider settings command."
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "ai.openai.codex.command.codex",
        "title": "Manage the OpenAI Codex account and provider settings"
      }
    ],
    "x-dev.dsh-std.extensions": [
      {
        "id": "ai.openai.codex.model-provider.openai-codex",
        "apiVersion": "models.dsh/v1alpha1",
        "kind": "ModelProvider",
        "name": "openai-codex",
        "spec": {
          "title": "OpenAI Codex",
          "titles": {
            "en": "OpenAI Codex",
            "zh": "OpenAI Codex"
          },
          "actions": {
            "authenticate": { "name": "codex", "path": ["login"] },
            "signout": { "name": "codex", "path": ["logout"] },
            "configure": { "name": "codex", "path": ["config"] }
          }
        }
      }
    ]
  },
  "subscriptions": [],
  "license": "Apache-2.0",
  "source": {
    "repository": "https://github.com/Yan-Zero/dsh-codex"
  }
}
