{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/standard.ts",
    "src/command.ts",
    "src/model-handler.ts",
    "src/service.ts",
    "src/auth.ts",
    "src/store.ts",
    "src/usage.ts",
    "src/responses.ts",
    "src/tool-policy.ts",
    "src/bin.ts",
    "tests/standard-component.spec.ts",
    "tests/store.spec.ts",
    "tests/response-runtime.spec.ts"
  ]
}
